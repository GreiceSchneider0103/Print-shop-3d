# Postgres (Supabase) — Prisma usa `DATABASE_URL` para runtime (via pooler,
# porta 6543 com pgbouncer) e `DIRECT_URL` para migrations (porta 5432, sem
# pooler). No Supabase: Project Settings > Database.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Google Sheets — service account com acesso de leitura à planilha
# "Controle Financeiro 3D". Compartilhe a planilha com o e-mail da service
# account (role: Viewer).
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Cole a chave privada do JSON da service account. Mantenha os `\n` literais
# (a lib faz o replace) ou use uma única linha entre aspas.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Segredo para autenticar a chamada do Vercel Cron ao endpoint de sync
# (cron requests enviam `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=""
