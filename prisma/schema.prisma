// Schema Prisma — Sistema de Gestão para Loja de Impressão 3D
// Fase 1: modela as tabelas da seção 4 do escopo, 1:1 com as abas da
// planilha "Controle Financeiro 3D".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Pedidos — aba "Vendas" / "Análise"
// ---------------------------------------------------------------------------
model Order {
  id              Int      @id @default(autoincrement())
  numeroPedido    String   @map("numero_pedido")
  numeroEcommerce String?  @map("numero_ecommerce")
  dataVenda       DateTime @map("data_venda")
  sku             String
  produto         String
  quantidade      Int
  valorTotal      Decimal  @map("valor_total") @db.Decimal(12, 2)
  comissao        Decimal  @db.Decimal(12, 2)
  freteCliente    Decimal  @default(0) @map("frete_cliente") @db.Decimal(12, 2)
  freteEmpresa    Decimal  @default(0) @map("frete_empresa") @db.Decimal(12, 2)
  canal           String
  uf              String?
  situacao        String
  clienteNome     String?  @map("cliente_nome")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  // Sem FK formal para Product: os dados vêm de abas independentes da
  // planilha e não há garantia de integridade referencial na origem
  // (SKU descontinuado, digitado errado, etc.).
  @@unique([numeroPedido, canal, sku], name: "numeroPedido_canal_sku")
  @@index([canal])
  @@index([situacao])
  @@index([dataVenda])
  @@index([sku])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Produtos / SKU — aba "CMV"
// ---------------------------------------------------------------------------
model Product {
  sku              String   @id
  produto          String
  custoUnitario    Decimal  @map("custo_unitario") @db.Decimal(12, 2)
  tempoProducaoMin Int?     @map("tempo_producao_min")
  tipoAnuncioMl    String?  @map("tipo_anuncio_ml")
  diasPreparoMl    Int?     @map("dias_preparo_ml")
  precoMl          Decimal? @map("preco_ml") @db.Decimal(12, 2)
  precoShopee      Decimal? @map("preco_shopee") @db.Decimal(12, 2)
  precoTiktok      Decimal? @map("preco_tiktok") @db.Decimal(12, 2)
  criadoEm         DateTime @default(now()) @map("criado_em")
  atualizadoEm     DateTime @updatedAt @map("atualizado_em")

  recipe ProductRecipe[]

  @@map("products")
}

// ---------------------------------------------------------------------------
// Ficha técnica — aba "Ficha Técnica" (consumo de filamento por SKU)
// ---------------------------------------------------------------------------
model ProductRecipe {
  id        Int     @id @default(autoincrement())
  sku       String
  filamento String
  gramas    Decimal @db.Decimal(10, 2)
  ordem     Int     @default(1)

  product Product @relation(fields: [sku], references: [sku], onDelete: Cascade)

  @@unique([sku, ordem])
  @@index([sku])
  @@map("product_recipe")
}

// ---------------------------------------------------------------------------
// Taxas por canal — aba "Taxas"
// ---------------------------------------------------------------------------
model ChannelFee {
  id          Int     @id @default(autoincrement())
  canal       String
  valorMin    Decimal @map("valor_min") @db.Decimal(12, 2)
  valorMax    Decimal @map("valor_max") @db.Decimal(12, 2)
  comissaoPct Decimal @map("comissao_pct") @db.Decimal(6, 4)
  taxaFixa    Decimal @default(0) @map("taxa_fixa") @db.Decimal(12, 2)
  observacao  String?

  @@index([canal])
  @@map("channel_fees")
}

// ---------------------------------------------------------------------------
// Custos fixos mensais — aba "Fixos"
// ---------------------------------------------------------------------------
model FixedCost {
  id        Int      @id @default(autoincrement())
  mes       DateTime @db.Date
  ads       Decimal  @default(0) @db.Decimal(12, 2)
  tiny      Decimal  @default(0) @db.Decimal(12, 2)
  mei       Decimal  @default(0) @db.Decimal(12, 2)
  outros    Decimal  @default(0) @db.Decimal(12, 2)
  parcela   Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal  @default(0) @db.Decimal(12, 2)
  reembolso Decimal  @default(0) @db.Decimal(12, 2)

  @@unique([mes])
  @@map("fixed_costs")
}

// ---------------------------------------------------------------------------
// Configuração de operação — aba "Config Operação"
// Guardado como histórico; a config vigente é sempre a mais recente
// (maior atualizadoEm).
// ---------------------------------------------------------------------------
model OperationConfig {
  id                    Int      @id @default(autoincrement())
  potenciaImpressora    Decimal  @map("potencia_impressora") @db.Decimal(10, 2)
  tarifaEnergia         Decimal  @map("tarifa_energia") @db.Decimal(10, 4)
  custoEnergiaHora      Decimal  @map("custo_energia_hora") @db.Decimal(10, 4)
  maoObraHora           Decimal  @map("mao_obra_hora") @db.Decimal(10, 2)
  depreciacaoManutencao Decimal  @map("depreciacao_manutencao") @db.Decimal(10, 2)
  atualizadoEm          DateTime @default(now()) @map("atualizado_em")

  @@map("operation_config")
}

// ---------------------------------------------------------------------------
// Fila de produção — aba "Produção (1)"
// ---------------------------------------------------------------------------
enum ProductionStatus {
  A_PRODUZIR
  EM_PRODUCAO
  PRODUZIDO
  POSTADO
}

model ProductionQueueItem {
  id            Int              @id @default(autoincrement())
  pedido        String
  cliente       String?
  sku           String
  produto       String
  quantidade    Int
  prazoPostagem DateTime?        @map("prazo_postagem")
  canal         String
  status        ProductionStatus @default(A_PRODUZIR)
  // Evita baixar o estoque mais de uma vez se o item voltar pra PRODUZIDO.
  estoqueBaixado Boolean         @default(false) @map("estoque_baixado")
  criadoEm      DateTime         @default(now()) @map("criado_em")
  atualizadoEm  DateTime         @updatedAt @map("atualizado_em")

  // Natural key da aba "Produção" — permite sincronizar sem duplicar nem
  // sobrescrever status/estoqueBaixado definidos pelo Kanban.
  @@unique([pedido, sku])
  @@index([status])
  @@index([prazoPostagem])
  @@index([sku])
  @@map("production_queue")
}

// ---------------------------------------------------------------------------
// Estoque de insumos — aba "Esteira" (estoque atual)
// ---------------------------------------------------------------------------
enum InventoryItemType {
  FILAMENTO
  OUTRO
}

model InventoryItem {
  insumo         String            @id
  tipo           InventoryItemType @default(FILAMENTO)
  estoqueAtualG  Decimal           @default(0) @map("estoque_atual_g") @db.Decimal(12, 2)
  estoqueMinimoG Decimal           @default(0) @map("estoque_minimo_g") @db.Decimal(12, 2)
  custoPorKg     Decimal           @map("custo_por_kg") @db.Decimal(12, 2)
  fornecedor     String?
  atualizadoEm   DateTime          @updatedAt @map("atualizado_em")

  movements InventoryMovement[]

  @@map("inventory")
}

// ---------------------------------------------------------------------------
// Movimentação de estoque — novo (não existe na planilha)
// ---------------------------------------------------------------------------
enum InventoryMovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

model InventoryMovement {
  id                Int                   @id @default(autoincrement())
  insumo            String
  tipo              InventoryMovementType
  quantidade        Decimal               @db.Decimal(12, 2)
  motivo            String?
  pedidoRelacionado String?               @map("pedido_relacionado")
  data              DateTime              @default(now())

  inventoryItem InventoryItem @relation(fields: [insumo], references: [insumo], onDelete: Cascade)

  @@index([insumo])
  @@index([data])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Prazos por canal — aba "Prazos"
// ---------------------------------------------------------------------------
model Deadline {
  id             Int     @id @default(autoincrement())
  canal          String  @unique
  diasUteisPrazo Int     @map("dias_uteis_prazo")
  observacao     String?

  @@map("deadlines")
}

// ---------------------------------------------------------------------------
// Log de sincronização — suporte ao job de sync (seção 6)
// ---------------------------------------------------------------------------
enum SyncStatus {
  SUCCESS
  ERROR
  PARTIAL
}

model SyncLog {
  id               Int        @id @default(autoincrement())
  source           String     @default("google_sheets")
  sheetTab         String?    @map("sheet_tab")
  status           SyncStatus
  recordsProcessed Int        @default(0) @map("records_processed")
  errorMessage     String?    @map("error_message")
  startedAt        DateTime   @map("started_at")
  finishedAt       DateTime?  @map("finished_at")

  @@index([source, startedAt])
  @@map("sync_logs")
}
